# HTTP
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/mailpilot

# Redis (BullMQ) — must be running or the API exits (ECONNREFUSED on 6379 = Redis off)
# Start quickly: from repo root run  npm run docker:up  (Redis + Mongo)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth (JWT bonus)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Encrypt per-user Gmail app passwords stored in MongoDB (required in production).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMTP_CREDENTIALS_ENCRYPTION_KEY=

# Email — optional fallback when a user has not configured SMTP in Settings.
# Per-user SMTP user / app password / sender name live in Settings (not .env).
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MailPilot <noreply@example.com>"

# Optional: Amazon SES (set EMAIL_PROVIDER=ses and configure AWS SDK env in production)
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Worker (set false to run HTTP only; use `npm run worker` separately)
RUN_EMAIL_WORKER=true

# API rate limit (per IP, 15 min window)
API_RATE_LIMIT_MAX=200
