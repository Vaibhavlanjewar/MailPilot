# HTTP
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:4000

# CORS: https://*.vercel.app is allowed by default (so Vercel → Render PATCH works without extra env).
# Set FRONTEND_URL / CORS_ORIGINS for localhost, custom domains, or non-Vercel hosts.
# FRONTEND_URL=https://mail-pilot-mu-one.vercel.app
# CORS_ORIGINS=https://app.example.com,http://localhost:5173
# CORS_STRICT=true   (only listed origins; blocks *.vercel.app unless listed above)

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/mailpilot

# Redis (BullMQ) — must be running or the API exits (ECONNREFUSED on 6379 = Redis off)
# Start quickly: from repo root run  npm run docker:up  (Redis + Mongo)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth (JWT bonus)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# OTP auth
# OTP_EXPIRY_MS=300000
# OTP_RESEND_COOLDOWN_MS=30000

# Encrypt per-user Gmail app passwords stored in MongoDB (required in production).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMTP_CREDENTIALS_ENCRYPTION_KEY=

# Email — optional fallback when a user has not configured SMTP in Settings.
# Per-user SMTP user / app password / sender name live in Settings (not .env).
EMAIL_PROVIDER=nodemailer

# Gmail API (recommended for outreach; set EMAIL_PROVIDER=gmail-api to force this path).
# Multi-user mode: each logged-in user connects Gmail via /api/users/me/gmail/connect-url.
# Set redirect URI in Google Console to your backend callback endpoint below.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=http://localhost:4000/api/users/gmail/callback
# Required for OTP emails via Gmail API:
# MAILPILOT_OTP_GMAIL_CLIENT_ID=
# MAILPILOT_OTP_GMAIL_CLIENT_SECRET=
# MAILPILOT_OTP_GMAIL_REDIRECT_URI=http://localhost:4000/api/users/gmail/callback
# MAILPILOT_OTP_GMAIL_REFRESH_TOKEN=
# MAILPILOT_OTP_GMAIL_SENDER_EMAIL=mailpilot.io@gmail.com
# Fallback (legacy):
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER_EMAIL=mailpilot.io@gmail.com

# Outreach pacing (anti-burst):
# EMAIL_BATCH_SIZE=2
# EMAIL_DELAY_MS=1500
# EMAIL_JITTER_MS=500
# EMAIL_MAX_RETRIES=3
# EMAIL_BATCH_PAUSE_MS=5000

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MailPilot <noreply@example.com>"

# SMTP client timeouts (ms). "Connection timeout" = TCP never opened — usually firewall/host, not these values.
# SMTP_CONNECTION_TIMEOUT_MS=120000
# SMTP_GREETING_TIMEOUT_MS=30000
# SMTP_SOCKET_TIMEOUT_MS=600000

# Optional: Amazon SES (set EMAIL_PROVIDER=ses and configure AWS SDK env in production)
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Worker (set false to run HTTP only; use `npm run worker` separately)
RUN_EMAIL_WORKER=true

# Email worker throughput (defaults: 1 job/sec, concurrency 1 — slow but SMTP-safe).
# After clicking Send, jobs enqueue quickly; delivery speed is limited by these + SMTP.
# Example for a dedicated transactional provider: EMAIL_RATE_LIMIT_MAX=10 EMAIL_WORKER_CONCURRENCY=2
# EMAIL_WORKER_CONCURRENCY=1
# EMAIL_RATE_LIMIT_MAX=1
# EMAIL_RATE_LIMIT_DURATION_MS=1000

# API rate limit (per IP, 15 min window)
API_RATE_LIMIT_MAX=200
