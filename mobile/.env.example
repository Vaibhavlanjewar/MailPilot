# Expo only inlines EXPO_PUBLIC_* vars into the app bundle — same rule as
# Vite's VITE_* prefix in client/.env. Never put a server secret here.

# Backend base URL. localhost only works when running in a web browser or an
# iOS simulator on the same Mac; Android emulator needs 10.0.2.2, and a real
# device (Expo Go on your phone) needs your machine's LAN IP, e.g.
# http://192.168.1.23:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Same Firebase web app config as client/.env (VITE_FIREBASE_*) — public,
# safe to duplicate here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# "Continue with Google" on Login/Register. This is the OAuth 2.0 "Web
# client" ID Firebase auto-created when Google sign-in was enabled — find it
# at Firebase Console > Authentication > Sign-in method > Google > Web SDK
# configuration ("Web client ID"), or Google Cloud Console > APIs & Services
# > Credentials for the hiringpilot project. Public, safe to ship in the app.
# Leave blank to hide/disable the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
