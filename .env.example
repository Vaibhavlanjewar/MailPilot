# Monorepo: copy this file to `server/.env` before running the API.
# See `server/.env.example` for full documentation of each variable.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/mailpilot
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
JWT_SECRET=dev-change-me
RUN_EMAIL_WORKER=true

# Per-user Gmail app passwords: set SMTP_CREDENTIALS_ENCRYPTION_KEY in server/.env (see server/.env.example).
# Optional shared SMTP fallback: SMTP_* in server/.env
