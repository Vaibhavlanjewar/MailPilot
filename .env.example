# ============================================================
#  MailPilot - single environment file for client + server
# ============================================================
#  Vite only inlines VITE_* vars into the browser bundle.
#  Everything else stays server-side. NEVER prefix a secret
#  with VITE_ or it ships to every visitor.
# ============================================================

# ---------- CLIENT (public - bundled into the browser) ----------
VITE_API_URL=/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# ---------- SERVER (private - never sent to the browser) ----------
# HTTP
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:4000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/mailpilot

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Hosted Redis (Upstash etc.) needs TLS; local/docker Redis does not.
REDIS_TLS=false

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Encrypt per-user SMTP credentials
SMTP_CREDENTIALS_ENCRYPTION_KEY=

# Email Configurations
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Worker setup
RUN_EMAIL_WORKER=true
EMAIL_WORKER_CONCURRENCY=1
EMAIL_RATE_LIMIT_MAX=1
EMAIL_RATE_LIMIT_DURATION_MS=1000

# API rate limit (per IP, 15 min window)
API_RATE_LIMIT_MAX=200

# Gemini & Langsmith
GOOGLE_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="vaibhav-ai"
GROQ_API=

# RapidAPI — JSearch (external job listings) and Judge0 CE (C/C++/Java code
# sandbox). One account key works for both, but it must be subscribed to each
# API separately or those routes return 403.
RAPIDAPI_JSEARCH_KEY=
RAPIDAPI_KEY=

# Firebase Admin: locally, credentials load from server/firebase.json (service
# account). On hosts with no such file (e.g. Render), set CLIENT_EMAIL and
# PRIVATE_KEY instead — keep the literal \n escapes in the key.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


# --- Gmail OAuth (required for "Sign in with Google" to also authorise sending) ---
# Create at: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Enable the Gmail API for the project, and add the Authorised redirect URI below verbatim.
# Scope requested: https://www.googleapis.com/auth/gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/users/gmail/callback
