# Dev: Vite proxies /api to the backend (see vite.config.js)
VITE_API_URL=/api

# Production (Vercel + API on Render): set at build time to your API origin + /api, and set
# FRONTEND_URL on the server to this Vercel origin (see server/.env.example).
# VITE_API_URL=https://mailpilot-46ve.onrender.com/api
